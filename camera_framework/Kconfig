menuconfig CAMERA_FRAMEWORK_ENABLE
    bool "Camera drivers"
    default y
    select RT_USING_SYSTEM_WORKQUEUE
    help
      Enable the camera framework, including the handle layer, sensor driver
      selection, control-bus settings, and data-bus backend settings.

if CAMERA_FRAMEWORK_ENABLE

    menu "Sensor settings"

        choice
            prompt "Active camera sensor"
            default SENSOR_USING_OV2640
            help
              Select the sensor driver that the camera handle layer binds to
              at compile time. New sensor drivers should add one option here.

            config SENSOR_USING_OV2640
                bool "Use OV2640"
                help
                  Enable this option to use OV2640 as the active camera driver.

            config SENSOR_USING_GC032A
                bool "Use GC032A"
                help
                  Enable this option to use GC032A as the active camera driver.

            config SENSOR_USING_BF30A2
                bool "Use BF30A2"
                select BSP_USING_SPI
                select BSP_USING_SPI2
                select BSP_SPI2_RX_USING_DMA
                select BSP_USING_SPI_DMA_CIRCULAR
                help
                  Enable this option to use BF30A2 as the active camera driver.
        endchoice

        choice
            prompt "GC032A output interface"
            depends on SENSOR_USING_GC032A
            default CAMERA_GC032A_INTERFACE_DVP_8BIT
            help
              Select the physical image-data interface used by GC032A.

            config CAMERA_GC032A_INTERFACE_DVP_8BIT
                bool "8-bit DVP"

            config CAMERA_GC032A_INTERFACE_SERIAL_2BIT
                bool "2-bit serial"
        endchoice

        config CAMERA_READ_TIMEOUT_MS
            int "Frame wait timeout (ms)"
            default 1000
            range 100 60000
            help
              Timeout value in milliseconds for blocking frame wait in
              single-shot capture.

    endmenu

    menu "SCCB settings"

        config CAMERA_SCCB_I2C_BUS_NAME
            string "I2C bus name"
            default "i2c1"
            help
              RT-Thread I2C bus device name used by the camera SCCB control bus.

        config CAMERA_SCCB_TIMEOUT_MS
            int "Timeout (ms)"
            default 1000
            help
              Timeout value in milliseconds for SCCB I2C transactions.

        config CAMERA_SCCB_MAX_HZ
            int "Max frequency (Hz)"
            default 100000
            range 10000 400000
            help
              Maximum I2C clock frequency used by the camera SCCB control bus.

        config CAMERA_SCCB_SCL_PIN
            int "SCCB SCL pin (PAx index)"
            default 30 if CAMERA_GC032A_INTERFACE_SERIAL_2BIT
            default 30 if SENSOR_USING_BF30A2
            default 76 if SOC_SF32LB56X
            default 40
            range 0 95
            help
              PAx pin used for the SCCB clock signal. GC032A serial examples
              use PA30 to avoid the PA37-PA39 image-data pins.

        config CAMERA_SCCB_SDA_PIN
            int "SCCB SDA pin (PAx index)"
            default 33 if CAMERA_GC032A_INTERFACE_SERIAL_2BIT
            default 33 if SENSOR_USING_BF30A2
            default 72 if SOC_SF32LB56X
            default 39
            range 0 95
            help
              PAx pin used for the SCCB data signal. GC032A serial examples
              use PA33 to avoid the PA37-PA39 image-data pins.

    endmenu

    menu "Data bus settings"

        config CAMERA_USING_DVP
            bool
            default y if SENSOR_USING_OV2640
            default y if CAMERA_GC032A_INTERFACE_DVP_8BIT

        config CAMERA_USING_SERIAL
            bool
            default y if CAMERA_GC032A_INTERFACE_SERIAL_2BIT

        config CAMERA_DATA_BUS_ADAPTER_NAME
            string
            default "dvp" if CAMERA_USING_DVP
            default "camera_serial" if CAMERA_USING_SERIAL
            help
              Internal helper symbol that resolves to the selected data bus
              adapter name for the active sensor interface.

        if CAMERA_USING_DVP

        config CAMERA_DVP_PINGPONG_POOL_SIZE
            int "Ping-pong pool size (compile-time ceiling)"
            default 10240
            range 1024 65536
            help
              Size of the statically allocated ping-pong buffer pool owned by
              the DVP backend. This is the hard upper limit for runtime
              ping-pong resizing.

        config CAMERA_DVP_PINGPONG_BUFFER_SIZE
            int "Initial ping-pong size"
            default 8192
            range 1024 CAMERA_DVP_PINGPONG_POOL_SIZE
            help
              Initial active ping-pong DMA size passed to the DVP bus.
              Must not exceed CAMERA_DVP_PINGPONG_POOL_SIZE.

        config CAMERA_DVP_PINGPONG_USE_SECTION
            bool "Place ping-pong pool in .dvp_pingpong section"
            default n
            help
              When enabled, the DVP backend ping-pong buffer pool is
              placed in the ".dvp_pingpong" linker section.

        config CAMERA_DVP_DATA_PIN_BASE
            int "DVP data pin base number"
            default 0
            help
              Internal helper option for DVP data pin base numbering.
              Do not modify unless you are adjusting the low-level platform port.

        config CAMERA_DVP_PCLK_PIN
            int "PCLK pin number (PAx index)"
            default 41
            help
              PAx pin index for the DVP pixel clock (PCLK) input.
              The driver muxes this pin to GPTIM1_ETR automatically.

        config CAMERA_DVP_HSYNC_PIN
            int "HSYNC pin number (PAx index)"
            default 43
            help
              PAx pin index for the DVP horizontal sync (HSYNC/HREF) input.
              The driver muxes this pin to GPTIM1_CH1 automatically.

        config CAMERA_DVP_VSYNC_PIN
            int "VSYNC pin number (PAx index)"
            default 42
            help
              PAx pin index for the DVP VSYNC GPIO interrupt input.

        endif

        if CAMERA_USING_SERIAL

        config CAMERA_SERIAL_SAMPLE_BUFFER_SIZE
            int "Serial GPIO DMA sample buffer size"
            default 32768
            range 1024 65528
            help
              Number of GPIO samples stored by the circular DMA buffer.
              The value must be a multiple of 8 and no greater than 65535.

        config CAMERA_SERIAL_WORKER_STACK_SIZE
            int
            default 2048

        endif

        config CAMERA_XCLK_PIN
            int "Sensor XCLK output pin (PAx index)"
            default 9 if CAMERA_GC032A_INTERFACE_SERIAL_2BIT
            default 9 if SENSOR_USING_BF30A2
            default -1
            help
              PAx pin index for XCLK output. Set to -1 to use an external
              sensor clock source.

        choice
            prompt "Sensor XCLK output frequency"
            default CAMERA_XCLK_FREQ_24M if SENSOR_USING_BF30A2
            default CAMERA_XCLK_FREQ_6M if CAMERA_GC032A_INTERFACE_SERIAL_2BIT
            default CAMERA_XCLK_FREQ_12M
            depends on CAMERA_XCLK_PIN != -1

            config CAMERA_XCLK_FREQ_24M
                bool "24 MHz"

            config CAMERA_XCLK_FREQ_6M
                bool "6 MHz"

            config CAMERA_XCLK_FREQ_12M
                bool "12 MHz"
        endchoice

        config CAMERA_XCLK_FREQ
            int
            default 24000000 if CAMERA_XCLK_FREQ_24M
            default 6000000 if CAMERA_XCLK_FREQ_6M
            default 12000000

    menu "BF30A2 settings"
        depends on SENSOR_USING_BF30A2

        config CAMERA_BF30A2_DMA_BUFFER_SIZE
            int "BF30A2 SPI DMA circular buffer size"
            default 8192
            range 1024 65534
    endmenu

    endmenu

endif
